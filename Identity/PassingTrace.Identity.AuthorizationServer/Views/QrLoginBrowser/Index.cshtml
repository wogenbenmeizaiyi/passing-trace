@model PassingTrace.Identity.AuthorizationServer.Controllers.QrLoginPageModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "登录星期八";
}

@if (Model.PasswordMode)
{
<section class="card compact password-login">
    <p class="eyebrow">欢迎回来</p>
    <h1>账号密码登录</h1>
    <p class="lede">使用与手机端相同的账号，继续记录生活。</p>
    <form method="post" action="/account/qr-login/@Model.Id/password" id="password-login-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="code" value="@Model.Code" />
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <label for="login-username">账号</label>
        <input id="login-username" name="username" value="@ViewData["LoginUsername"]" autocomplete="username" maxlength="256" required autofocus />
        <label for="login-password">密码</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" maxlength="4096" required />
        <button type="button" class="password-toggle" aria-controls="login-password" aria-pressed="false">显示密码</button>
        <button class="button full" type="submit">登录</button>
    </form>
    <p class="footnote"><a href="/account/qr-login/@Model.Id?code=@Uri.EscapeDataString(Model.Code)">使用手机扫码登录</a></p>
</section>
<script>
(() => {
    const form = document.getElementById('password-login-form');
    const toggle = form.querySelector('.password-toggle');
    const password = document.getElementById('login-password');
    toggle.addEventListener('click', () => {
        const visible = password.type === 'password';
        password.type = visible ? 'text' : 'password';
        toggle.setAttribute('aria-pressed', String(visible));
        toggle.textContent = visible ? '隐藏密码' : '显示密码';
    });
    form.addEventListener('submit', () => {
        const submit = form.querySelector('[type=submit]');
        submit.disabled = true;
        submit.textContent = '正在登录…';
    });
    window.addEventListener('pageshow', () => {
        const submit = form.querySelector('[type=submit]');
        submit.disabled = false;
        submit.textContent = '登录';
    });
})();
</script>
}
else
{
<section class="card qr-login" data-transaction-id="@Model.Id" data-poll-seconds="@Model.PollIntervalSeconds" data-state="waiting">
    <div class="qr-login__copy">
        <p class="eyebrow">手机确认登录</p>
        <h1>用星期八扫描二维码</h1>
        <p><a href="/account/qr-login/@Model.Id?code=@Uri.EscapeDataString(Model.Code)&amp;mode=password">使用账号密码登录 →</a></p>
        <p class="lede">你正在登录 <strong>@Model.ClientDisplayName</strong>。打开手机端左侧菜单里的“扫一扫”，并确认本次浏览器登录。</p>

        <ol class="qr-steps" aria-label="扫码登录步骤">
            <li><span>1</span><p><strong>打开星期八</strong><small>进入左侧菜单，点击“扫一扫”</small></p></li>
            <li><span>2</span><p><strong>扫描右侧二维码</strong><small>确认网站和浏览器信息后批准登录</small></p></li>
        </ol>

        @if (Model.ProductUrl is { } productUrl)
        {
            <div class="qr-download">
                <p>还没安装星期八？<a href="@productUrl" target="_blank" rel="noopener noreferrer" aria-label="下载手机 App（新标签页打开）">下载手机 App</a></p>
                <small>无需登录即可下载，安装后回到此页扫码登录。</small>
            </div>
        }

        <div class="security-note">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.8 2.8 8.1 7 10 4.2-1.9 7-5.2 7-10V6l-7-3Z"/><path d="m9.2 12 1.8 1.8 3.8-4"/></svg>
            <span>二维码只用于这一次登录，请勿分享给其他人。</span>
        </div>
    </div>

    <div class="qr-login__visual">
        <div class="qr-code" role="img" aria-label="星期八登录二维码">@Html.Raw(Model.Svg)</div>
        <p id="qr-status" class="qr-status" role="status" aria-live="polite" aria-atomic="true">
            <span aria-hidden="true"></span>
            <strong>等待手机确认</strong>
        </p>
        <noscript><p class="qr-noscript">需要启用 JavaScript 才能自动完成登录。</p></noscript>
    </div>

    <form id="complete-form" method="post" action="/account/qr-login/@Model.Id/complete" hidden>
        @Html.AntiForgeryToken()
    </form>
</section>

<script>
(() => {
    const root = document.querySelector('.qr-login');
    const status = document.getElementById('qr-status');
    const form = document.getElementById('complete-form');
    const id = root.dataset.transactionId;
    const delay = Number(root.dataset.pollSeconds) * 1000;
    let stopped = false;

    async function poll() {
        if (stopped) return;
        try {
            const response = await fetch(`/account/qr-login/${id}/status`, {
                credentials: 'same-origin',
                cache: 'no-store'
            });
            if (!response.ok) throw new Error('status');
            const result = await response.json();
            if (result.status === 'pending') {
                root.dataset.state = 'waiting';
                status.querySelector('strong').textContent = '等待手机确认';
            }
            if (result.status === 'approved') {
                stopped = true;
                root.dataset.state = 'approved';
                status.querySelector('strong').textContent = '已确认，正在完成登录';
                form.submit();
                return;
            }
            if (result.status === 'rejected') {
                stopped = true;
                root.dataset.state = 'rejected';
                status.querySelector('strong').textContent = '手机已拒绝本次登录';
                return;
            }
            if (result.status === 'expired') {
                stopped = true;
                root.dataset.state = 'expired';
                status.querySelector('strong').textContent = '二维码已过期，请重新登录';
                return;
            }
        } catch {
            root.dataset.state = 'retrying';
            status.querySelector('strong').textContent = '网络不稳定，正在重试';
        }
        window.setTimeout(poll, delay);
    }
    window.setTimeout(poll, delay);
})();
</script>
}
