{
  "Identity": {
    "Authority": "https://localhost:56228/"
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "Bucket": "passingtrace-private",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "AppUpdates": {
    "AndroidManifestKey": "releases/android/latest.json",
    "DownloadUrlLifetimeMinutes": 30
  },
  "AiModels": {
    "Assistant": {
      "Provider": "MiniMax",
      "PrimaryModel": "MiniMax-M3",
      "FallbackModel": "MiniMax-M2.7"
    },
    "Semantic": {
      "Provider": "MiniMax",
      "PrimaryModel": "MiniMax-M3",
      "FallbackModel": "MiniMax-M2.7"
    },
    "Embedding": {
      "Provider": "Qwen",
      "Model": "text-embedding-v4",
      "Dimensions": 1024
    },
    "Providers": {
      "MiniMax": {
        "Endpoint": "https://api.minimaxi.com/v1",
        "StripThinkingTags": true,
        "UseRemoteMediaUrls": true
      },
      "Qwen": {
        "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1"
      }
    },
    "PipelineVersion": "semantic-v2",
    "PromptVersion": "passingtrace-zh-v2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
