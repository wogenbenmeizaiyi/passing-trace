FROM node:24-alpine AS web-build
WORKDIR /src
RUN corepack enable
COPY passingtrace-web/package.json passingtrace-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY passingtrace-web/ ./
ARG VITE_IDENTITY_AUTHORITY
ARG VITE_EVENTS_API_BASE_URL
ENV VITE_IDENTITY_AUTHORITY=$VITE_IDENTITY_AUTHORITY \
    VITE_EVENTS_API_BASE_URL=$VITE_EVENTS_API_BASE_URL
RUN pnpm build

FROM caddy:2.10-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /src/dist /srv
