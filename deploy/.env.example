WEB_DOMAIN=passingtrace.com
AUTH_DOMAIN=auth.passingtrace.com

# GitHub Actions 部署时固定到当前提交对应的 GHCR 镜像。
IDENTITY_IMAGE=passingtrace-identity:latest
EVENTS_IMAGE=passingtrace-events:latest
WORKER_IMAGE=passingtrace-worker:latest
CADDY_IMAGE=passingtrace-caddy:latest

POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
# 生产附件使用私有雨云 S3 兼容存储，手机/Web 通过预签名 URL 直传。
S3_ENDPOINT=https://cn-nb1.rains3.com
S3_PUBLIC_ENDPOINT=https://cn-nb1.rains3.com
S3_BUCKET=passingtrace
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=replace-with-a-new-rainyun-access-key
S3_SECRET_KEY=replace-with-a-new-rainyun-secret-key
CERTIFICATE_PASSWORD=replace-with-a-long-random-password
REGISTRATION_BOOTSTRAP_CODE=replace-with-a-private-one-time-code
# 个人主账号 + 独立演示账号；达到上限后注册自动关闭。
IDENTITY_MAX_USERS=2

QWEN_API_KEY=replace-with-your-bailian-api-key
MINIMAX_API_KEY=replace-with-your-minimax-api-key
AMAP_WEB_SERVICE_KEY=replace-with-your-amap-web-service-key
# 可选；留空时 AI 高德工具复用上面的 Web 服务 Key。
AMAP_MCP_KEY=
