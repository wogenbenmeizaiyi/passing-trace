<Project>
  <!-- 中央包管理（CPM）：统一维护全仓 PackageReference 版本。 -->
  <ItemGroup>
    <!-- Aspire 13.5.1 稳定版；Kubernetes 集成仅 preview：13.5.1-preview.1.26420.4 -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="13.5.1-preview.1.26420.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.1" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.1" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.1" />
    <!-- ASP.NET Core 共享框架 -->
    <PackageVersion Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.11" />
    <!-- EF Core / 数据访问 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <!-- OpenIddict -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.6.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!-- AI / 对象存储 / 媒体处理 -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <!-- 其他 -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
  </ItemGroup>
</Project>
